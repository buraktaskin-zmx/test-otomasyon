<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.ykb.uplift</groupId>
    <artifactId>uptest-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.7</version>
        <relativePath/>
    </parent>

    <!--
      Two deployables, deliberately separate:

        uptest-executor      Cucumber + Playwright. Runs tests. 236 MB image.
        uptest-orchestrator  UI, validation, dispatch. Never runs a test, so it
                             must not carry the Playwright driver bundle.

      Splitting them here rather than later keeps each image free of the other's
      dependencies; see src/main/java/server/CLAUDE.md.
    -->
    <modules>
        <module>uptest-executor</module>
        <module>uptest-orchestrator</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
        <cucumber.version>7.33.0</cucumber.version>
        <!-- 2.x is the line built against Spring Framework 7. Spring AI 1.1.0
             resolves but dies at startup here: its OpenAiAudioApi calls
             HttpHeaders.addAll(MultiValueMap), removed in Spring 7. -->
        <spring-ai.version>2.0.0</spring-ai.version>

        <!--
          H2, the orchestrator's run-history database. Pinned here rather than
          inherited silently from spring-boot-dependencies, and the reason is
          the file on disk:

          H2's on-disk format is NOT guaranteed stable across its own minor
          versions — the 1.4 -> 2.0 jump required an explicit export/import,
          and 2.x has moved the format before. Inheriting the version means a
          routine Boot patch upgrade can carry a new H2 whose first contact
          with the existing file is "General error: ... unsupported database
          format", and the run history is unreadable until someone finds the
          old jar.

          So this is a decision the project makes deliberately, not a side
          effect of a Boot bump. Overriding the BOM's property is the idiomatic
          mechanism; the orchestrator's <dependency> carries no <version>.
        -->
        <h2.version>2.4.240</h2.version>
    </properties>

    <dependencyManagement>
        <dependencies>

            <!--
              Spring AI. "openai" names the WIRE PROTOCOL, not a destination:
              vLLM serves Qwen behind the same /v1/chat/completions schema, so
              requests go to an internal host and nothing leaves the bank.
            -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>io.cucumber</groupId>
                <artifactId>cucumber-bom</artifactId>
                <version>${cucumber.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>5.14.1</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-bom</artifactId>
                <version>3.27.6</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.4</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
