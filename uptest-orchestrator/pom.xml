<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.ykb.uplift</groupId>
        <artifactId>uptest-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>uptest-orchestrator</artifactId>
    <packaging>jar</packaging>

    <!--
      Deliberately does NOT depend on uptest-executor: that would drag the
      Playwright driver bundle (~200 MB) into an application that never opens a
      browser. The two talk over HTTP only.
    -->
    <dependencies>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
          Spring AI's OpenAI-compatible chat model. The artifact is named after
          the wire protocol, not the vendor: vLLM serves Qwen behind the same
          /v1/chat/completions schema, so this talks to the bank's internal
          endpoint and nothing leaves the network.

          Version comes from spring-ai-bom in the parent, pinned to the 2.x line
          — 1.1.0 is built against Spring Framework 6 and kills the context at
          startup under Spring Boot 4. Auto-configuration also REQUIRES
          spring.ai.openai.api-key to be present, even for an endpoint that
          authenticates nobody; see application.properties.
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <!-- The real Gherkin parser, so validation reports the same line
             numbers and syntax errors Cucumber itself would. -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>gherkin</artifactId>
        </dependency>

        <!-- Compiles "enter amount {string} {string}" into the same matcher
             Cucumber uses, instead of re-implementing placeholder matching. -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-expressions</artifactId>
        </dependency>

        <!-- Reads the screen catalogs so the validator can check what a step
             put inside its quotes (CatalogModel). Already on the classpath via
             spring-boot-starter, but declared here because it is used directly:
             a transitive dependency can disappear in an upgrade without warning.
             Version comes from spring-boot-starter-parent. -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
