{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,

    /*
      The orchestrator returns BARE ARRAYS from GET /api/v1/runs and from the
      artifacts endpoint, and RunController warns that wrapping either in a
      Spring Page would silently blank the pane. This flag is the client-side
      half of that guard: it makes every indexed read T | undefined, so the
      "it is always there" assumption has to be written down to compile.
    */
    "noUncheckedIndexedAccess": true,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "vite.config.ts"]
}
